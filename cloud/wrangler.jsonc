{
  // recap-cloud:凭证签发器 + 法务静态页(一个 Worker 全包,挂在 recap.manymind.chat)
  "name": "recap-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "ASR_WSS": "wss://dashscope.aliyuncs.com/api-ws/v1/inference/",
    "LLM_BASE": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ASR_MODEL": "paraformer-realtime-v2",
    // 英文托管会议(X-Recap-Lang: en)下发的模型。fun-asr-realtime 本身即多语言(自动语种
    // 检测/时间戳/热词)——百炼无英文专用实时模型(paraformer-realtime-en-v1 不存在,
    // 2026-08-23 探针 ModelNotFound + 官方文档双确认),与 zh 同模型、白名单已放通。
    "ASR_MODEL_EN": "fun-asr-realtime",
    // 钉死快照(2026-09-02):官方价格页确认 `qwen-plus` 别名已冻结=2025-12-01,plus 新款
    // (qwen3.X-plus)涨价 2.5-4 倍——裸别名有被阿里日后重指涨价款的静默成本风险。
    // ⚠️ 切换/升级时须同步:百炼 key 白名单加新模型名 + 客户端 LLMProviderConfig.cloudDefaultModel
    // (TranscriptChunker 按 contains 匹配 qwen-plus 前缀,快照名天然兼容)。
    "LLM_MODEL": "qwen-plus-2025-12-01",
    // 托管 LLM 中转代理(plan 056)：/v1/relay 的转发目标与强制模型。真实 Key 与 HMAC 签名密钥
    // 是 Secrets(RELAY_API_KEY / RELAY_HMAC_SECRET，见下方注释块)；三件齐备后 /v1/issue
    // 才下发 relay_* 字段，未配置 = 灰度旧形状(旧客户端零感知)。
    "RELAY_BASE_URL": "https://token.toai.pro/v1",
    "LLM_RELAY_MODEL": "auto/glm",
    // 百炼控制台「业务定制—热词」创建的全局共享词表 id(≤500 词,运营维护品牌词/常见术语)。
    // ⚠️ 词表 target_model 必须与 ASR_MODEL 一致——换模型须同步改绑词表并重跑
    // scripts/verify-gateway-asr.mjs 词表探针,否则托管档 run-task task-failed。
    // 留空 = 不启用(issue 响应不带 asr_vocabulary_id)。
    "ASR_VOCABULARY_ID": ""
  },

  // 绑定 manymind.chat 子域(zone 已在本 CF 账号下;asr. 已被占用,用 recap.)
  "routes": [{ "pattern": "recap.manymind.chat", "custom_domain": true }],

  // per-user 月度配额 Durable Object(Workers Free plan 即可用)。
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "QuotaDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaDO"] }],

  // Workers Logs(免费内置,保留 3 天):prove/issue/quota 路径的 console.log 由此可查,
  // 上线后排障不再盲查。head_sampling_rate=1 记录全部请求(量小,成本为零)。
  "observability": { "enabled": true, "head_sampling_rate": 1 }

  // Secrets(部署后注入,wrangler secret put):
  //   DASHSCOPE_API_KEY     阿里主 key(RAM 最小权限子账号)。⚠️ 必须在百炼控制台配「模型访问限制」白名单:
  //                        fun-asr-realtime + paraformer-realtime-v2 + qwen-plus-2025-12-01(漏开则 st-token 403;
  //                        多开则免费用户可持 ASR 桶 token 调高价模型——临时 token 继承 key 全部权限)。
  //                        部署后跑 scripts/verify-gateway-asr.mjs(含负向探针)+ verify-sts-llm.mjs 双确认。
  //   DASHSCOPE_ASR_API_KEY (可选加固)ASR 专用子账号 key,白名单仅开两个 ASR 模型;
  //                        配置后 ASR 桶与 LLM 桶 token 物理隔离,主 key 白名单误配也刷不了 LLM。
  //   RELAY_API_KEY        plan 056 托管 LLM 中转真实 Key(原随客户端二进制分发,现只存 secret——
  //                        开源红线)。⚠️ 旧值已入 git 历史/已售二进制,新版 adoption 达阈值后必须
  //                        在中转侧轮换作废(plan 056 Wave C 观察窗:旧版托管流量 <10% 或异常放量)。
  //   RELAY_HMAC_SECRET    relay_token 的 HMAC-SHA256 签名密钥(任意高熵随机串,如 `openssl rand -base64 32`)。
  //   APPLE_PRIVATE_KEY / APPLE_KEY_ID / APPLE_ISSUER_ID / APPLE_BUNDLE_ID   Phase 2 真实验证
  //
  // Phase 2(用户量起来):加 Durable Object 做 per-user 配额(需 Workers Paid plan $5/月),
  //   复用 src/adapter/quota-do.ts + src/core/quota.ts(已写好待接入)。
}
