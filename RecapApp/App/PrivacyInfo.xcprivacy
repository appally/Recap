<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Recap 不进行任何用户追踪：无 IDFA、无广告 SDK、无跨 app 数据关联。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- 数据收集声明（2026-08-07 与代码事实对齐）：
	     云端模式（Pro/免费档）下，录音音频经 FunASREngine WebSocket 实时上传阿里 DashScope 完成
	     语音识别；转写文本与纪要请求经 OpenAICompatibleProvider 发送至所选的 LLM 服务商
	     （网关签发 token 走 qwen-plus，BYOK 走用户自配端点）。均为"App 功能"用途，匿名处理
	     （不携带 Recap 侧身份，token 无用户标识），故 Linked=false / Tracking=false。
	     声纹 embedding 与说话人分离仅在设备内推理（VoiceprintGallery 本机持久化），不上云，不声明。
	     App Store Connect 隐私问卷须与下列声明一致（音频/用户内容/设备标识符/位置/购买记录）。 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudio</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required Reason API（全库核实 2026-08-07）：
	     - UserDefaults：app 自身偏好/状态（ASR/凭证/配额/账户/声纹 ID/模板收藏/搜索历史/feature flag），CA92.1。
	     - DiskSpace：SettingsComponents.DiskSpace.hasAvailable 用
	       volumeAvailableCapacityForImportantUsageKey 做模型/资源下载前空间预检，E174.1。
	     - FileTimestamp：全库 attributesOfItem 仅读 .size（音频时长/缓存校验），未读时间戳，不触发。
	     - SystemBootTime（仅 thermalState，非 RR）/ ActiveKeyboards 均无命中。 -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 读写 app 自身偏好（ASR/凭证/配额/个性化等设置），符合 CA92.1。 -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 下载端侧模型/资源前检查磁盘可用容量（SettingsComponents.swift DiskSpace.hasAvailable），符合 E174.1。 -->
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
